{
  "upstreams": [
    {
      "name": "context7",
      "description": "docs",
      "transport": "http",
      "url": "https://mcp.context7.com/mcp",
      "bearer": "${CTX_KEY}"
    },
    {
      "name": "time",
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ],
      "env": {
        "TZ": "UTC"
      }
    }
  ]
}
